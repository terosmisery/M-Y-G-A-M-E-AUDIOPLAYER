--==================================================
-- LOOP REGION
--==================================================

local loopEnabled = true

local function updateLoop()

	if not loopEnabled then
		return
	end

	if musicPlayer.TimeLength <= 0 then
		return
	end

	local text =
		loopBox.Text

	local startString, endString =
		string.match(
			text,
			"^%s*([%d%.]+)%s*%-%s*([%d%.]+)%s*$"
		)

	if not startString then
		return
	end

	local startTime =
		tonumber(startString)

	local endTime =
		tonumber(endString)

	if not startTime
		or not endTime then
		return
	end

	if endTime <= startTime then
		return
	end

	startTime =
		math.clamp(
			startTime,
			0,
			musicPlayer.TimeLength
		)

	endTime =
		math.clamp(
			endTime,
			0,
			musicPlayer.TimeLength
		)

	if endTime <= startTime then
		return
	end

	musicPlayer.PlaybackRegionsEnabled =
		true

	musicPlayer.LoopRegion =
		NumberRange.new(
			startTime,
			endTime
	)
end

loopBox.FocusLost:Connect(updateLoop)

--==================================================
-- LOAD AUDIO
--==================================================

local function loadAudio()

	local id =
		tostring(
			idBox.Text
		)

	id =
		id:gsub(
			"%s+",
			""
		)

	if id == "" then

		status.Text =
			"NO AUDIO ID ENTERED"

		say(
			"No audio asset ID was entered.",
			2
		)

		return false
	end

	if not string.match(
		id,
		"^rbxassetid://"
	) then

		if not tonumber(id) then

			status.Text =
				"INVALID AUDIO ID"

			say(
				"That does not appear to be a valid audio asset ID.",
				2.5
			)

			return false
		end

		id =
			"rbxassetid://" ..
			id
	end

	musicPlayer:Stop()

	musicPlayer.SoundId =
		id

	musicPlayer.TimePosition =
		0

	musicPlayer.Volume =
		number(
			volumeBox,
			1
		)

	musicPlayer.PlaybackSpeed =
		number(
			speedBox,
			1
		)

	musicPlayer.Looped =
		loopEnabled

	applyEffects()

	status.Text =
		"CHECKING AUDIO..."

	say(
		"Checking the requested audio source.",
		2
	)

	--==================================================
	-- WAIT FOR LOAD
	--==================================================

	if not musicPlayer.IsLoaded then

		local loaded =
			false

		local failed =
			false

		local connection

		connection =
			musicPlayer.Loaded:Connect(
				function()
					loaded = true
				end
			)

		local startedAt =
			os.clock()

		while not loaded
			and not musicPlayer.IsLoaded
			and not failed do

			if os.clock() -
				startedAt >= 12 then

				failed = true

				break
			end

			task.wait(
				0.1
			)
		end

		if connection then
			connection:Disconnect()
		end

		if failed then

			status.Text =
				"FAILED TO LOAD AUDIO"

			say(
				"I could not load that audio source.",
				2.5
			)

			return false
		end
	end

	--==================================================
	-- VERIFY LOADED AUDIO
	--==================================================

	task.wait(0.2)

	local length =
		musicPlayer.TimeLength

	if not musicPlayer.IsLoaded
		or length <= 0 then

		status.Text =
			"AUDIO IS NOT PLAYABLE"

		say(
			"The audio source loaded, but no playable audio data was received.",
			3
		)

		return false
	end

	loadedAudioId =
		id

	timeLengthLabel.Text =
		"Length: " ..
		string.format(
			"%.2f",
			length
		)

	status.Text =
		"AUDIO READY"

	say(
		"Audio source loaded successfully.",
		2
	)

	say(
		"The audio is ready to play.",
		2
	)

	return true
end

--==================================================
-- PLAY
--==================================================

local function playAudio()

	if loadedAudioId == "" then

		if not loadAudio() then
			return
		end
	end

	stopGameSounds()

	applyEffects()
	updateLoop()

	musicPlayer.Looped =
		loopEnabled

	if not musicPlayer.IsPlaying then

		musicPlayer:Play()

	end

	playing =
		true

	musicActive =
		true

	status.Text =
		"PLAYING  •  " ..
		loadedAudioId
end

--==================================================
-- PAUSE
--==================================================

local function pauseAudio()

	musicPlayer:Pause()

	playing =
		false

	status.Text =
		"PAUSED"
end

--==================================================
-- STOP
--==================================================

local function stopAudio()

	musicPlayer:Stop()

	playing =
		false

	musicActive =
		false

	status.Text =
		"STOPPED"

	stopGameSounds()
end

--==================================================
-- RESTART
--==================================================

local function restartAudio()

	if loadedAudioId == "" then
		return
	end

	musicPlayer:Stop()

	musicPlayer.TimePosition =
		0

	applyEffects()

	musicPlayer:Play()

	playing =
		true

	musicActive =
		true

	status.Text =
		"RESTARTED"
end

