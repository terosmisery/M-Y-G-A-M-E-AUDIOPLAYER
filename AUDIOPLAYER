--==================================================
-- LOAD AUDIO
--==================================================

local function loadAudio()

	local id =
		tostring(
			idBox.Text
		)

	id =
		id:gsub(
			"%s+",
			""
		)

	if id == "" then

		status.Text =
			"STATUS: NO ID"

		say(
			"No audio asset ID was entered.",
			2
		)

		return false
	end

	if not string.match(
		id,
		"^rbxassetid://"
	) then

		if not tonumber(id) then

			status.Text =
				"STATUS: INVALID ID"

			say(
				"That does not appear to be a valid audio asset ID.",
				2.5
			)

			return false
		end

		id =
			"rbxassetid://" ..
			id
	end

	musicActive =
		false

	playing =
		false

	musicPlayer:Stop()

	musicPlayer.SoundId =
		id

	musicPlayer.TimePosition =
		0

	status.Text =
		"STATUS: CHECKING"

	visualStatus.Text =
		"CHECKING AUDIO..."

	-- Keep the verification dialogue.
	say(
		"Checking the requested audio source.",
		2
	)

	say(
		"Contacting the audio source.",
		2
	)

	if not musicPlayer.IsLoaded then

		local loaded =
			false

		local connection =
			musicPlayer.Loaded:Connect(
				function()
					loaded = true
				end
			)

		local started =
			os.clock()

		while not loaded
			and not musicPlayer.IsLoaded
			and os.clock() -
				started < 12 do

			task.wait(
				0.1
			)
		end

		connection:Disconnect()
	end

	if not musicPlayer.IsLoaded then

		status.Text =
			"STATUS: LOAD FAILED"

		visualStatus.Text =
			"AUDIO FAILED TO LOAD"

		say(
			"The audio source could not be loaded.",
			2.5
		)

		return false
	end

	task.wait(0.25)

	if musicPlayer.TimeLength <= 0 then

		status.Text =
			"STATUS: NOT PLAYABLE"

		visualStatus.Text =
			"NO PLAYABLE AUDIO"

		say(
			"The source loaded, but no playable audio was detected.",
			3
		)

		return false
	end

	loadedAudioId =
		id

	timeDisplay.Text =
		"00:00 / " ..
		string.format(
			"%.2f",
			musicPlayer.TimeLength
		)

	status.Text =
		"STATUS: READY"

	visualStatus.Text =
		"AUDIO READY"

	say(
		"Audio source loaded successfully.",
		2
	)

	say(
		"The audio is ready to play.",
		2
	)

	return true
end

--==================================================
-- PLAYBACK
--==================================================

local function playMusic()

	if loadedAudioId == "" then

		if not loadAudio() then
			return
		end
	end

	stopGameSounds()

	applyControls()

	musicPlayer.Looped =
		true

	musicPlayer:Play()

	musicActive =
		true

	playing =
		true

	status.Text =
		"STATUS: PLAYING"

	visualStatus.Text =
		"PLAYING"
end

local function pauseMusic()

	musicPlayer:Pause()

	playing =
		false

	visualStatus.Text =
		"PAUSED"
end

local function stopMusic()

	musicPlayer:Stop()

	musicActive =
		false

	playing =
		false

	status.Text =
		"STATUS: STOPPED"

	visualStatus.Text =
		"STOPPED"
end

local function restartMusic()

	if loadedAudioId == "" then
		return
	end

	musicPlayer:Stop()

	musicPlayer.TimePosition =
		0

	applyControls()

	musicPlayer:Play()

	musicActive =
		true

	playing =
		true

	visualStatus.Text =
		"RESTARTED"
end

