--==================================================
-- AUDIO LOADER / VERIFICATION
--==================================================

local function loadAudio()

	local id =
		tostring(
			idBox.Text
		)

	id =
		id:gsub(
			"%s+",
			""
		)

	if id == "" then

		status.Text =
			"NO ID"

		say(
			"No audio asset ID was entered.",
			2
		)

		return false
	end

	if not string.match(
		id,
		"^rbxassetid://"
	) then

		if not tonumber(id) then

			status.Text =
				"INVALID ID"

			say(
				"That does not appear to be a valid audio asset ID.",
				2.5
			)

			return false
		end

		id =
			"rbxassetid://" ..
			id
	end

	musicActive =
		false

	playing =
		false

	musicPlayer:Stop()

	musicPlayer.SoundId =
		id

	musicPlayer.TimePosition =
		0

	applySimpleControls()

	status.Text =
		"CHECKING..."

	-- Dialogue BEFORE playback.
	say(
		"Checking the requested audio source.",
		2
	)

	say(
		"Contacting the audio source.",
		2
	)

	--==================================================
	-- WAIT FOR LOAD
	--==================================================

	if not musicPlayer.IsLoaded then

		status.Text =
			"LOADING..."

		local loaded =
			false

		local connection =
			musicPlayer.Loaded:Connect(
				function()
					loaded = true
				end
			)

		local start =
			os.clock()

		while not loaded
			and not musicPlayer.IsLoaded
			and os.clock() -
				start < 12 do

			task.wait(
				0.1
			)
		end

		connection:Disconnect()
	end

	if not musicPlayer.IsLoaded then

		status.Text =
			"LOAD FAILED"

		say(
			"The audio source could not be loaded.",
			2.5
		)

		return false
	end

	task.wait(0.25)

	if musicPlayer.TimeLength <= 0 then

		status.Text =
			"NO PLAYABLE AUDIO"

		say(
			"The source loaded, but no playable audio was detected.",
			3
		)

		return false
	end

	loadedAudioId =
		id

	timeDisplay.Text =
		"00:00 / " ..
		string.format(
			"%.2f",
			musicPlayer.TimeLength
		)

	status.Text =
		"AUDIO READY"

	say(
		"Audio source loaded successfully.",
		2
	)

	say(
		"The audio is ready to play.",
		2
	)

	return true
end

--==================================================
-- PLAY
--==================================================

local function playMusic()

	if loadedAudioId == "" then

		if not loadAudio() then
			return
		end
	end

	stopGameSounds()

	applySimpleControls()

	if not simpleMode then
		applyAdvancedControls()
	end

	musicPlayer.Looped =
		loopEnabled

	musicPlayer:Play()

	musicActive =
		true

	playing =
		true

	status.Text =
		"PLAYING"
end

