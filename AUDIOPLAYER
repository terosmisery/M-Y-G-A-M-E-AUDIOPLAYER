progressBackground.InputBegan:Connect(
	function(input)

		if input.UserInputType ~=
			Enum.UserInputType.MouseButton1 then

			return
		end

		if musicPlayer.TimeLength <= 0 then
			return
		end

		local x =
			input.Position.X -
			progressBackground.AbsolutePosition.X

		local alpha =
			math.clamp(
				x /
				progressBackground.AbsoluteSize.X,
				0,
				1
			)

		musicPlayer.TimePosition =
			alpha *
			musicPlayer.TimeLength

	end
)

--==================================================
-- VISUALIZER
--==================================================

local visualizerTime =
	0

RunService.RenderStepped:Connect(
	function(dt)

		visualizerTime += dt

		local active =
			musicPlayer.IsPlaying

		local loudness =
			0

		if active then

			pcall(function()

				loudness =
					math.clamp(
						musicPlayer.PlaybackLoudness /
							300,
						0,
						1
					)

			end)

		end

		for i, bar in ipairs(bars) do

			local wave =
				(
					math.sin(
						visualizerTime * 3 +
						i * 0.55
					)
					+ 1
				)
				* 0.5

			local wave2 =
				(
					math.sin(
						visualizerTime * 5 -
						i * 0.3
					)
					+ 1
				)
				* 0.5

			local target =
				active
				and (
					0.12 +
					loudness *
					(
						0.25 +
						wave *
						0.55 +
						wave2 *
						0.2
					)
				)
				or 0.06

			target =
				math.clamp(
					target,
					0.04,
					1
				)

			bar.Size =
				UDim2.new(
					1 / BAR_COUNT * 0.72,
					0,
					target,
					0
				)

			bar.Position =
				UDim2.new(
					(i - 1) /
						BAR_COUNT,
					0,
					1,
					-8
				)
		end

		-- Time display.
		if musicPlayer.TimeLength > 0 then

			timeDisplay.Text =
				string.format(
					"%02d:%02d / %02d:%02d",
					math.floor(
						musicPlayer.TimePosition / 60
					),
					math.floor(
						musicPlayer.TimePosition
					) % 60,
					math.floor(
						musicPlayer.TimeLength / 60
					),
					math.floor(
						musicPlayer.TimeLength
					) % 60
				)

			progressFill.Size =
				UDim2.new(
					math.clamp(
						musicPlayer.TimePosition /
							musicPlayer.TimeLength,
						0,
						1
					),
					0,
					1,
					0
				)

		end

		-- Detect natural ending.
		if musicActive
			and not musicPlayer.IsPlaying
			and not musicPlayer.IsPaused
			and not loopEnabled then

			musicActive =
				false

			playing =
				false

			status.Text =
				"ENDED"
		end
	end
)

