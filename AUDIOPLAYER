--==================================================
-- PLAY MUSIC
--==================================================

local playing = false

local function playMusic(id)

	id = tostring(id)

	if id == "" then
		status.Text = "Enter an audio ID first."
		return
	end

	if not string.match(id, "^rbxassetid://") then
		id = "rbxassetid://" .. id
	end

	playing = false
	musicActive = false

	musicPlayer:Stop()

	musicPlayer.SoundId = id
	musicPlayer.Volume = getNumber(volumeBox, 1, 0, 1)
	musicPlayer.PlaybackSpeed =
		getNumber(speedBox, 1, 0.05, 3)
	musicPlayer.Pitch =
		getNumber(pitchBox, 1, 0.05, 3)
	musicPlayer.TimePosition =
		math.max(0, tonumber(timeBox.Text) or 0)

	distortion.Level =
		getNumber(distortionBox, 0, 0, 1)

	status.Text = "Initializing audio..."

	stopGameSounds()

	say(
		"Initializing music player.",
		2
	)

	say(
		"Preparing the requested audio.",
		2
	)

	say(
		"Checking the audio source.",
		2
	)

	if not musicPlayer.IsLoaded then

		status.Text = "Loading audio..."

		local loaded = false

		local connection

		connection =
			musicPlayer.Loaded:Connect(function()
				loaded = true
			end)

		local startedAt = os.clock()

		while not loaded
			and not musicPlayer.IsLoaded
			and os.clock() - startedAt < 10 do

			task.wait(0.1)
		end

		if connection then
			connection:Disconnect()
		end
	end

	if not musicPlayer.IsLoaded then

		status.Text =
			"Audio failed to load."

		say(
			"The audio could not be loaded.",
			2.5
		)

		return
	end

	say(
		"Audio source loaded successfully.",
		2
	)

	say(
		"Starting playback now.",
		2
	)

	applyControls()

	musicPlayer:Play()

	musicActive = true
	playing = true

	status.Text =
		"Playing: " .. musicPlayer.SoundId
end

--==================================================
-- BUTTON EVENTS
--==================================================

playButton.Activated:Connect(function()

	if playing then
		musicPlayer:Stop()
		playing = false
	end

	playMusic(idBox.Text)
end)

stopButton.Activated:Connect(function()

	musicActive = false

	musicPlayer:Stop()

	stopGameSounds()

	playing = false

	status.Text =
		"Playback stopped."

	say(
		"Music stopped.",
		1.5
	)
end)

