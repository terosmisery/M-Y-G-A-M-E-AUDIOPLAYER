local soundsToDisable = {
	"Amb",
	"Level1",
	"Level2",
	"GameOver",
	"Final"
}

local function stopGameSounds()
	for _, soundName in ipairs(soundsToDisable) do
		local sound = mainUI:FindFirstChild(soundName, true)

		if sound and sound:IsA("Sound") then
			sound:Stop()
			sound.Volume = 0
		end
	end
end

