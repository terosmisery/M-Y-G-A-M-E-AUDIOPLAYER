--==================================================
-- DIALOGUE
--==================================================

local function say(text, duration)
	text = tostring(text)
	duration = duration or 2

	dialogueLabel.AutoLocalize = false
	dialogueLabel.Text = text
	dialogueLabel.Parent.Visible = true

	pcall(function()
		requestSpeech:Invoke(
			{
				{
					text,
					{
						IgnoreLocalize = true
					}
				}
			},
			false,
			duration,
			characterVoice
		)
	end)

	if characterVoice.IsPlaying then
		characterVoice:Stop()
	end

	dialogueLabel.Text = ""
	dialogueLabel.Parent.Visible = false

	task.wait(0.15)
end

--==================================================
-- NUMBER PARSER
--==================================================

local function getNumber(box, default, minimum, maximum)
	local value = tonumber(box.Text)

	if not value then
		value = default
	end

	return math.clamp(value, minimum, maximum)
end

--==================================================
-- APPLY CONTROLS
--==================================================

local function applyControls()
	musicPlayer.Volume =
		getNumber(volumeBox, 1, 0, 1)

	musicPlayer.PlaybackSpeed =
		getNumber(speedBox, 1, 0.05, 3)

	-- Roblox Sound.Pitch
	musicPlayer.Pitch =
		getNumber(pitchBox, 1, 0.05, 3)

	musicPlayer.TimePosition =
		math.max(
			0,
			getNumber(
				timeBox,
				0,
				0,
				musicPlayer.TimeLength > 0
					and musicPlayer.TimeLength
					or math.huge
			)
		)

	distortion.Level =
		getNumber(
			distortionBox,
			0,
			0,
			1
		)
end

