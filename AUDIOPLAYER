local function playMusic()

	if loadedAudioId == "" then

		if not loadAudio() then
			return
		end
	end

	stopGameSounds()

	applyControls()

	musicPlayer.Looped =
		true

	musicPlayer:Play()

	musicActive =
		true

	playing =
		true

	status.Text =
		"STATUS: PLAYING"

	visualStatus.Text =
		"PLAYING"
end

local function pauseMusic()

	musicPlayer:Pause()

	playing =
		false

	visualStatus.Text =
		"PAUSED"
end

local function stopMusic()

	musicPlayer:Stop()

	musicActive =
		false

	playing =
		false

	status.Text =
		"STATUS: STOPPED"

	visualStatus.Text =
		"STOPPED"
end

local function restartMusic()

	if loadedAudioId == "" then
		return
	end

	musicPlayer:Stop()

	musicPlayer.TimePosition =
		0

	applyControls()

	musicPlayer:Play()

	musicActive =
		true

	playing =
		true

	visualStatus.Text =
		"RESTARTED"
end

