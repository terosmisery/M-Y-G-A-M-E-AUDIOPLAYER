--==================================================
-- PLAY FUNCTION
--==================================================

local function playAudio()

	local id =
		tostring(
			idBox.Text
		)

	if id == "" then

		status.Text =
			"ENTER AN AUDIO ID"

		return
	end

	if not string.match(
		id,
		"^rbxassetid://"
	) then

		id =
			"rbxassetid://" ..
			id

	end

	musicPlayer:Stop()

	musicPlayer.SoundId =
		id

	musicPlayer.Looped =
		true

	musicPlayer.Volume =
		1

	musicPlayer.PlaybackSpeed =
		1

	musicPlayer.TimePosition =
		0

	status.Text =
		"LOADING..."

	if not musicPlayer.IsLoaded then

		local loaded =
			false

		local connection

		connection =
			musicPlayer.Loaded:Connect(
				function()
					loaded = true
				end
			)

		local startTime =
			os.clock()

		while not loaded
			and not musicPlayer.IsLoaded
			and os.clock() -
				startTime < 10 do

			task.wait(
				0.1
			)
		end

		if connection then
			connection:Disconnect()
		end
	end

	if not musicPlayer.IsLoaded then

		status.Text =
			"FAILED TO LOAD"

		return
	end

	musicPlayer:Play()

	status.Text =
		"PLAYING"

end

