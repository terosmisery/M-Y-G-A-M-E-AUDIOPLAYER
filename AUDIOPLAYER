local function makeLabel(
	parent,
	text,
	x,
	y,
	w,
	h,
	size
)

	local l =
		Instance.new("TextLabel")

	l.Position =
		UDim2.fromOffset(
			x,
			y
		)

	l.Size =
		UDim2.fromOffset(
			w,
			h or 20
		)

	l.BackgroundTransparency =
		1

	l.Text =
		text

	l.TextColor3 =
		Color3.fromRGB(
			165,
			165,
			165
		)

	l.TextSize =
		size or 12

	l.Font =
		Enum.Font.GothamMedium

	l.TextXAlignment =
		Enum.TextXAlignment.Left

	l.Parent =
		parent

	return l
end

