local function number(
	boxObject,
	fallback
)

	local n =
		tonumber(
			boxObject.Text
		)

	if n == nil then
		return fallback
	end

	return n
end

local function applyControls()

	musicPlayer.Volume =
		math.clamp(
			number(
				volumeBox,
				1
			),
			0,
			1
		)

	musicPlayer.PlaybackSpeed =
		math.clamp(
			number(
				speedBox,
				1
			),
			0.05,
			20
		)

	pitchShift.Octave =
		math.clamp(
			number(
				pitchBox,
				0
			),
			-4,
			4
		)

	distortion.Level =
		math.clamp(
			number(
				distortionBox,
				0
			),
			0,
			1
		)

	local position =
		math.max(
			0,
			number(
				timeBox,
				0
			)
		)

	if musicPlayer.TimeLength > 0 then

		position =
			math.clamp(
				position,
				0,
				musicPlayer.TimeLength
			)
	end

	musicPlayer.TimePosition =
		position
end

