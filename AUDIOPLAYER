progressBackground.InputBegan:Connect(
	function(input)

		if input.UserInputType ~=
			Enum.UserInputType.MouseButton1 then

			return
		end

		if musicPlayer.TimeLength <= 0 then
			return
		end

		local x =
			input.Position.X -
			progressBackground.AbsolutePosition.X

		local ratio =
			math.clamp(
				x /
				progressBackground.AbsoluteSize.X,
				0,
				1
			)

		musicPlayer.TimePosition =
			musicPlayer.TimeLength *
			ratio
	end
)

--==================================================
-- VISUALIZER
--==================================================

local visualTime =
	0

RunService.RenderStepped:Connect(
	function(dt)

		visualTime +=
			dt

		local loudness =
			0

		if musicPlayer.IsPlaying then

			pcall(
				function()

					loudness =
						math.clamp(
							musicPlayer.PlaybackLoudness /
								300,
							0,
							1
						)
				end
			)
		end

		for i, bar in ipairs(
			bars
		) do

			local wave =
				(
					math.sin(
						visualTime *
							4 +
						i *
							0.45
					)
					+ 1
				) * 0.5

			local wave2 =
				(
					math.sin(
						visualTime *
							7 -
						i *
							0.25
					)
					+ 1
				) * 0.5

			local height

			if musicPlayer.IsPlaying then

				height =
					0.08 +
					loudness *
					(
						0.2 +
						wave *
							0.5 +
						wave2 *
							0.2
					)

			else

				height =
					0.04 +
					wave *
						0.04
			end

			height =
				math.clamp(
					height,
					0.035,
					0.95
				)

			bar.Size =
				UDim2.new(
					1 /
						BAR_COUNT *
						0.7,
					0,
					height,
					0
				)
		end

		if musicPlayer.TimeLength > 0 then

			local current =
				musicPlayer.TimePosition

			local total =
				musicPlayer.TimeLength

			timeDisplay.Text =
				string.format(
					"%02d:%02d / %02d:%02d",
					math.floor(
						current /
							60
					),
					math.floor(
						current
					) % 60,
					math.floor(
						total /
							60
					),
					math.floor(
						total
					) % 60
				)

			progressFill.Size =
				UDim2.new(
					math.clamp(
						current /
							total,
						0,
						1
					),
					0,
					1,
					0
				)
		end
	end
)

